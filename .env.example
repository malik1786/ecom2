# ═══════════════════════════════════════════════════════════
# SUFI PERFUMES — FRONTEND (VITE) ENV CONFIGURATION
# ═══════════════════════════════════════════════════════════

# ── API Service URLs ──
# Leave commented for local dev (Vite proxy handles routing).
# Uncomment and set for production/Vercel deployment.
# VITE_API_BASE_URL=http://127.0.0.1:5000
# VITE_AUTH_BASE_URL=http://127.0.0.1:5001
# VITE_PAYMENT_BASE_URL=http://127.0.0.1:5002

# ── OAuth ──
VITE_GOOGLE_ENABLED=false

# ── Payment Gateway: Razorpay (Frontend Key) ──
# Paste your Razorpay KEY_ID (public key) here when ready to go live.
# This is the key_id (NOT the secret). Safe to expose in frontend.
# Leave blank to disable online Razorpay checkout on the frontend.
VITE_RAZORPAY_KEY_ID=
